{
  "name": "@jmespath-community/jmespath",
  "description": "Typescript implementation of the JMESPath Community specification",
  "version": "1.5.0",
  "author": {
    "name": "JMESPath Community",
    "email": "springcomp@users.noreply.github.com",
    "url": "https://jmespath.site"
  },
  "type": "module",
  "bin": {
    "jp": "./dist/cli.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "browser": "./dist/index.umd.js",
  "unpkg": "./dist/index.umd.min.js",
  "jsdelivr": "./dist/index.umd.min.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "browser": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.esm.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.umd.js"
        },
        "default": "./dist/index.umd.js"
      },
      "node": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.mjs"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./stream": {
      "import": {
        "types": "./dist/stream.d.ts",
        "default": "./dist/stream.mjs"
      },
      "require": {
        "types": "./dist/stream.d.cts",
        "default": "./dist/stream.cjs"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/cli.d.ts",
        "default": "./dist/cli.mjs"
      },
      "require": {
        "types": "./dist/cli.d.cts",
        "default": "./dist/cli.cjs"
      }
    }
  },
  "files": [
    "dist/"
  ],
  "homepage": "https://github.com/jmespath-community/typescript-jmespath",
  "bugs": {
    "url": "https://github.com/jmespath-community/typescript-jmespath/issues"
  },
  "keywords": [
    "jmespath",
    "jsonpath",
    "query",
    "json",
    "jq",
    "xpath"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmespath-community/typescript-jmespath.git"
  },
  "license": "MPL-2.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "lint:ci": "biome check --diagnostic-level=error",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsdown",
    "dev": "tsx src/cli.ts",
    "perf": "node --expose-gc scripts/perf.js",
    "perf:stream": "node --expose-gc scripts/stream-perf.js",
    "start": "tsdown --watch",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:prod": "npm run lint:ci && npm run typecheck && npm run test",
    "test:build": "npm run build && npm test -- test/build-artifacts.spec.ts",
    "coverage": "vitest run --coverage",
    "deploy-docs": "node scripts/gh-pages-publish.cjs",
    "typecheck": "tsc --noEmit",
    "hooks:install": "node scripts/install-hooks.js",
    "check:pkg": "publint"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.5",
    "publint": "^0.3.25",
    "shelljs": "^0.10.0",
    "tinybench": "^6.2.0",
    "tsdown": "~0.23.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
